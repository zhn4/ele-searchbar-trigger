{
  "name": "ele-searchbar-trigger",
  "version": "1.0.0",
  "description": "Collapse/expand part of an Element UI (Vue 2) search form with one call. 一个函数折叠 / 展开 Element UI 搜索栏的表单项。",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "sideEffects": false,
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhn4/ele-searchbar-trigger.git"
  },
  "bugs": {
    "url": "https://github.com/zhn4/ele-searchbar-trigger/issues"
  },
  "homepage": "https://github.com/zhn4/ele-searchbar-trigger#readme",
  "keywords": [
    "vue",
    "vue2",
    "element-ui",
    "elementui",
    "el-form",
    "search-bar",
    "search-form",
    "collapse",
    "expand",
    "form",
    "utility"
  ],
  "author": "zhou",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^9.39.1",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "vite": "^7.2.2"
  }
}
